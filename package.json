{
  "name": "public-embrilo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "build": "tsc -b && tsc -p server/tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run test && npm run build",
    "functions:build": "wrangler pages functions build --outdir .wrangler/functions-build",
    "dev:full": "wrangler pages dev dist --d1 DB=embrilo-public-local --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 execute embrilo-public-local --local --file=migrations/0001_public_core.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name embrilo-public --branch main"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.4",
    "@clerk/clerk-react": "^5.61.11",
    "@clerk/localizations": "^3.37.10",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "hono": "^4.13.14",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jose": "^5.10.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
