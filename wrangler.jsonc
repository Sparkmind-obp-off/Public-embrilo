{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Public Embrilo website: static SPA + Pages Functions (/api/*) on Cloudflare Pages.
  // Separate from the internal "embrilo-os" project. Secrets are NOT stored here:
  //   wrangler pages secret put CLERK_SECRET_KEY / DUITKU_MERCHANT_CODE / DUITKU_API_KEY --project-name embrilo-public
  "name": "embrilo-public",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_BASE_URL": "https://embrilo-public.pages.dev",
    // Clerk publishable key is public by design (it ships to the browser).
    // PRODUCTION instance (domain embrilo-public.pages.dev, Frontend API via same-origin proxy /__clerk).
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZW1icmlsby1wdWJsaWMucGFnZXMuZGV2JA",
    "CLERK_AUTHORIZED_PARTIES": "https://embrilo-public.pages.dev,https://embrilo.biz.id",
    "DUITKU_ENV": "production",
    // Kill switch. Stays "false" until Duitku production credentials and an approved price exist.
    "PAYMENTS_ENABLED": "false"
  },
  // Public Embrilo's own database (separate from embrilo-os-production).
  "d1_databases": [
    { "binding": "DB", "database_name": "embrilo-public-production", "database_id": "39b023c1-8ba6-4473-9f2d-584f7c8ee293", "migrations_dir": "migrations" }
  ]
}
