{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Public Embrilo website — static SPA on Cloudflare Pages.
  // Separate from the internal "embrilo-os" project; no bindings, no secrets.
  "name": "embrilo-public",
  "compatibility_date": "2024-01-01",
  "pages_build_output_dir": "./dist"
}
